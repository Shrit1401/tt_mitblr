# The frontend prototype needs no environment variables.
# Optional backend source handoff, not executed or validated in this delivery.
DATABASE_URL=postgresql://domino_runtime:replace-locally@127.0.0.1:5432/domino
REDIS_URL=redis://:replace-locally@127.0.0.1:6379/0
POSTGRES_PASSWORD=replace-locally
REDIS_PASSWORD=replace-locally
WORKER_TENANT_IDS=
DOMINO_OPTIMIZER_ENABLED=false
# Absolute optimizer script path is recommended for a future reviewed deployment.
# DOMINO_OPTIMIZER_SCRIPT=/absolute/path/to/services/optimizer/solver.py
# DOMINO_PYTHON=python3
